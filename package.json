{
  "name": "dsh-x-watch",
  "version": "0.1.0",
  "description": "X Watch: a corner card that shows new posts and replies from X accounts in Chinese. It ships with a Tibo (@thsottiaux) reset-watch preset and accepts any JSON source.",
  "type": "module",
  "license": "MIT",
  "author": "OWNER",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "x",
    "twitter",
    "translate",
    "widget",
    "notify"
  ],
  "homepage": "https://github.com/OWNER/dsh-x-watch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-x-watch.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/dsh-x-watch/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "screenshots.json",
    "screenshots/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
